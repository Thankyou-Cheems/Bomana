{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Thankyou-Cheems/Bomana/docs/specs/schemas/web-dashboard-command-response.schema.json",
  "title": "Bomana Web Dashboard Command Response",
  "oneOf": [
    {"$ref": "#/$defs/queued"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "queued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "status", "submitted_revision"],
      "properties": {
        "schema_version": {"const": 1},
        "command_id": {"$ref": "#/$defs/commandId"},
        "status": {"const": "queued"},
        "submitted_revision": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "error"},
        "error": {
          "enum": [
            "pairing_required",
            "control_required",
            "host_invalid",
            "origin_required",
            "origin_mismatch",
            "csrf_required",
            "csrf_invalid",
            "content_type_required",
            "content_length_required",
            "body_too_large",
            "chunked_not_allowed",
            "invalid_json",
            "schema_invalid",
            "idempotency_required",
            "idempotency_invalid",
            "idempotency_conflict",
            "idempotency_capacity",
            "capability_unavailable",
            "queue_unavailable"
          ]
        },
        "command_id": {"$ref": "#/$defs/commandId"}
      }
    }
  }
}
