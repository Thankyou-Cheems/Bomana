{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thankyou-cheems.github.io/Bomana/specs/schemas/app-manifest.schema.json",
  "title": "Bomana app release manifest",
  "x-contract-kind": "release-owned-app-manifest",
  "x-signed-fields": [
    "schema_version",
    "channel",
    "app_version",
    "min_launcher_version",
    "entrypoint",
    "package_asset",
    "package_sha256"
  ],
  "type": "object",
  "required": [
    "schema_version",
    "channel",
    "app_version",
    "min_launcher_version",
    "entrypoint",
    "package_asset",
    "package_sha256",
    "manifest_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "channel": {
      "type": "string",
      "enum": ["Enhanced", "Standard", "Lite"]
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "min_launcher_version": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "package_asset": {
      "type": "string",
      "pattern": "^Bomana_app_(Enhanced|Standard|Lite)_v.+[.]zip$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_signature": {
      "$ref": "#/$defs/manifest_signature"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "manifest_signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
