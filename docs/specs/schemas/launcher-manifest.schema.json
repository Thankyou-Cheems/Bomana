{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thankyou-cheems.github.io/Bomana/specs/schemas/launcher-manifest.schema.json",
  "title": "Bomana launcher release manifest",
  "x-contract-kind": "release-owned-launcher-manifest",
  "x-signed-fields": [
    "schema_version",
    "launcher_version",
    "launcher_asset",
    "launcher_sha256",
    "launcher_size_bytes"
  ],
  "type": "object",
  "required": [
    "schema_version",
    "launcher_version",
    "launcher_asset",
    "launcher_sha256",
    "launcher_size_bytes",
    "manifest_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "launcher_version": {
      "type": "string",
      "minLength": 1
    },
    "launcher_asset": {
      "type": "string",
      "pattern": "^Bomana_launcher_v.+[.]exe$"
    },
    "launcher_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launcher_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_signature": {
      "$ref": "#/$defs/manifest_signature"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "manifest_signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
