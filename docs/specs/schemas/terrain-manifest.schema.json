{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thankyou-cheems.github.io/Bomana/specs/schemas/terrain-manifest.schema.json",
  "title": "Bomana terrain release manifest",
  "x-contract-kind": "release-owned-terrain-manifest",
  "x-signed-fields": [
    "schema_version",
    "terrain_pack_id",
    "terrain_revision",
    "map_count",
    "total_size_bytes",
    "files"
  ],
  "type": "object",
  "required": [
    "schema_version",
    "terrain_pack_id",
    "terrain_revision",
    "map_count",
    "total_size_bytes",
    "files",
    "manifest_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "terrain_pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "terrain_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1023
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["path", "asset", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "string",
            "pattern": "^Bomana_terrain_object_[0-9a-f]{64}([.][a-z0-9]+)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        },
        "additionalProperties": false
      }
    },
    "manifest_signature": {
      "$ref": "#/$defs/manifest_signature"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "manifest_signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
