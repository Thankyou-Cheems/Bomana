# Normalize text line endings for WSL/Windows development.
* text=auto eol=lf

# Keep Windows-native scripts in CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Raw 8111 replay fixtures are exact-byte gzip artifacts with manifest hashes.
tests/fixtures/8111/*.jsonl.gz binary
bomana/data/offline_rigidbody_catalog.bin binary

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads
