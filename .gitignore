# Bomana .gitignore

# ============================================================================
# Python
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
# `.python-version` is tracked to pin the repo's validated local interpreter.

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ============================================================================
# IDE / Editors
# ============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ============================================================================
# Operating System
# ============================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# Project Specific
# ============================================================================

# 用户配置文件（保存在用户主目录，但可能有测试文件）
.wttimer_config.json
.wttimer_state.json

# 启动器运行时文件（本地源码目录调试时会生成）
launcher_state.json
.bomana_temp_meta.json
.bomana_install_id
.bomana_update.lock

# 发布签名公钥模块由 tools/build_portable.py 在打包启动器时临时生成
bomana/release_public_keys.py

# 打包输出
dist/
build/

# 源码调试时可将零安装热键 Broker 构建到这里；发布包由打包脚本重新注入
bomana/bin/

# Tests are source files in this repository. Do not ignore tests/ or test_*.py.

# 临时文件
*.tmp
*.bak
*.old

# 日志文件
*.log

# 截图/录屏与原始 8111 对局录制（仅用于本地开发测试）
screenshots/
recordings/
*.gif
*.mp4

# 文档草稿
docs/drafts/
*.draft.md

# 个人笔记
NOTES.md
TODO_PRIVATE.md

# ============================================================================
# Git
# ============================================================================

# Git 合并冲突文件
*.orig

# ============================================================================
# 其他
# ============================================================================

# 压缩文件（除了发布用的）
*.zip
*.7z
*.rar
*.tar.gz

# 但保留 Release 相关的压缩文件
!releases/*.zip
!releases/*.7z

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads / Dolt files (added by bd init)
.beads-credential-key
