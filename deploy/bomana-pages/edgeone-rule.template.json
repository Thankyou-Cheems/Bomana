{
  "RuleName": "bomana-public-static",
  "Status": "enable",
  "Description": [
    "Canonical Bomana landing site with encrypted origin pull and bounded static caching"
  ],
  "Branches": [
    {
      "Condition": "${http.request.host} in ['bomana.ruikang.wang']",
      "Actions": [
        {
          "Name": "OriginPullProtocol",
          "OriginPullProtocolParameters": {
            "Protocol": "https"
          }
        },
        {
          "Name": "Cache",
          "CacheParameters": {
            "NoCache": {
              "Switch": "on"
            }
          }
        },
        {
          "Name": "OfflineCache",
          "OfflineCacheParameters": {
            "Switch": "on"
          }
        },
        {
          "Name": "ForceRedirectHTTPS",
          "ForceRedirectHTTPSParameters": {
            "Switch": "on",
            "RedirectStatusCode": 301
          }
        }
      ],
      "SubRules": [
        {
          "Description": [
            "Mutable site documents use a short EdgeOne cache"
          ],
          "Branches": [
            {
              "Condition": "${http.request.uri.path} in ['/', '/index.html', '/site.js', '/styles.css', '/download-catalog.json']",
              "Actions": [
                {
                  "Name": "Cache",
                  "CacheParameters": {
                    "CustomTime": {
                      "Switch": "on",
                      "IgnoreCacheControl": "off",
                      "CacheTime": 60
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "Description": [
            "Stable-name screenshots and images use a bounded one-hour cache"
          ],
          "Branches": [
            {
              "Condition": "${http.request.uri.path} in ['/assets/*']",
              "Actions": [
                {
                  "Name": "Cache",
                  "CacheParameters": {
                    "CustomTime": {
                      "Switch": "on",
                      "IgnoreCacheControl": "off",
                      "CacheTime": 3600
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
